// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  username  String
  createdAt DateTime
}

model Event {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  creatorId String  @db.ObjectId // who made this event[can be shared later?]
  name      String // name of event?
  color     String?
  notes     String?
}

// indexable by userId and date.
model DailyLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  date       DateTime
  activities Json
  notes      String?
}

